# ============================================================
# Famba — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ──────────────────────────────────────────────
# GENERAL
# ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Famba
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# ──────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://famba_user:famba_pass@localhost:5432/famba_db?schema=public

# ──────────────────────────────────────────────
# REDIS (Session/Cache)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# JWT (Authentication)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# GOOGLE OAUTH
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ──────────────────────────────────────────────
# STRIPE (Payment)
# Set STRIPE_MOCK_MODE=true to use demo payments
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_MOCK_MODE=true

# ──────────────────────────────────────────────
# CLOUDINARY (Image Uploads)
# Set CLOUDINARY_MOCK_MODE=true to use local storage
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_MOCK_MODE=true

# ──────────────────────────────────────────────
# EMAIL (Nodemailer/SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Famba <noreply@famba.com>

# ──────────────────────────────────────────────
# GOOGLE MAPS
# ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ──────────────────────────────────────────────
# API CONFIG
# ──────────────────────────────────────────────
API_PORT=5000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_MAX_SIZE_MB=10

# ──────────────────────────────────────────────
# NEXT.JS PUBLIC VARIABLES
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Famba
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_MOCK_MODE=true

# ──────────────────────────────────────────────
# WHATSAPP BOT (CodeChat — self-hosted)
# Docs: https://github.com/code-chat-br/whatsapp-api
# ──────────────────────────────────────────────
CODECHAT_URL=http://localhost:8083
CODECHAT_API_KEY=your-codechat-global-api-key
CODECHAT_INSTANCE=famba
CODECHAT_WEBHOOK_SECRET=any-random-secret-for-security

# Stripe webhook secret specifically for WhatsApp bot payments
# (can be the same as STRIPE_WEBHOOK_SECRET if using one endpoint)
STRIPE_WHATSAPP_WEBHOOK_SECRET=whsec_your_whatsapp_webhook_secret

# ──────────────────────────────────────────────
# INSURANCE (Zimnat)
# ──────────────────────────────────────────────
# Set to false when you have real Zimnat API access
ZIMNAT_MOCK_MODE=true
# When you get Zimnat API credentials, add them here:
# ZIMNAT_API_URL=https://api.zimnat.co.zw
# ZIMNAT_API_KEY=your-zimnat-api-key


# ──────────────────────────────────────────────
# ADMIN CONFIG
# ──────────────────────────────────────────────
ADMIN_EMAIL=admin@famba.com
ADMIN_PASSWORD=Admin@Famba2024!
